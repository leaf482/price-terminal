# Local development only; these are public example credentials, not secrets.
# Use plain KEY=value lines without quotes for the README shell commands.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=price_terminal
PGUSER=price_terminal
PGPASSWORD=local_dev_only
PGSSLMODE=disable
# Backend binding: use 0.0.0.0:8080 only in a trusted deployment network.
LISTEN_ADDR=127.0.0.1:8080
# Frontend server/rewrite target; set identically during build and start.
BACKEND_URL=http://127.0.0.1:8080
# Optional Fake collection. Empty means no configured provider.
COLLECTOR_CONFIG=
COLLECTION_INTERVAL=1m
COLLECTION_TIMEOUT=10s
PRICE_MAX_AGE=15m
